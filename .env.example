# ===== Designer Multi-Agent · 环境变量 =====
#
# ⚠️ 重要：本项目有【两条完全独立】的鉴权通道，不要混淆：
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ 通道 A · LLM 推理（agent 的"大脑"）                              │
# │   走哪个模型 = TUI session 选择 / opencode.json 全局 model       │
# │   key 存在 ~/.local/share/opencode/auth.json                    │
# │   由 `opencode providers login` 命令管理                         │
# │   ★ 与本 .env 文件无关 ★                                          │
# └─────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ 通道 B · 文生图（designer 调 text_to_image 工具时的副作用调用）   │
# │   .opencode/tools/text_to_image.ts 通过 fetch 直接调外部 API     │
# │   key 由本 .env 文件提供                                         │
# │   ★ 这才是本文件配置的对象 ★                                       │
# └─────────────────────────────────────────────────────────────────┘
#
# 推论：如果你只想跑文本流程（不出图），.env 可以完全为空——
#       因为 designer 会自动 fallback 到 dryrun 模式生成 1×1 占位 PNG。
#       如果你想出真图，按下方填写。

# --- 文生图（设计工具）Provider ---
# text_to_image.ts 工具直接 fetch 文生图 API，与 opencode 的 LLM 调用是两个独立通道。
# 取值: minimax | openai | tongyi | custom | dryrun
# 推荐 custom（OpenAI 兼容协议，可对接 SiliconFlow / Pollinations / Replicate / 自部署 ComfyUI 等高质量服务）
DESIGNER_IMAGE_PROVIDER=custom

# ╔═══════════════════════════════════════════════════════════════════╗
# ║ 推荐 · custom 模式（OpenAI 兼容文生图 · 任意 baseURL+key+model）    ║
# ╚═══════════════════════════════════════════════════════════════════╝
# 凡是暴露 POST {base}/images/generations 标准 OpenAI 接口的服务都可走这里。
# 请求体: {model, prompt, n, size}；响应自动兼容 url / b64_json 两种格式。
#
# 三个必填变量：
CUSTOM_IMAGE_BASE_URL=https://api.siliconflow.cn/v1
CUSTOM_IMAGE_API_KEY=
CUSTOM_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
#
# ── 流行服务参考配置（取消注释挑一个用）──
#
# 【SiliconFlow · 国内、免费额度足、有 FLUX/SDXL】
# CUSTOM_IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# CUSTOM_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell        # 速度快、免费
# CUSTOM_IMAGE_MODEL=black-forest-labs/FLUX.1-dev            # 质量高、付费
# CUSTOM_IMAGE_MODEL=stabilityai/stable-diffusion-3-5-large  # SD3.5
#
# 【DeepInfra】
# CUSTOM_IMAGE_BASE_URL=https://api.deepinfra.com/v1/openai
# CUSTOM_IMAGE_MODEL=black-forest-labs/FLUX-1-schnell
#
# 【Together AI】
# CUSTOM_IMAGE_BASE_URL=https://api.together.xyz/v1
# CUSTOM_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell-Free
#
# 【Fireworks】
# CUSTOM_IMAGE_BASE_URL=https://api.fireworks.ai/inference/v1
# CUSTOM_IMAGE_MODEL=accounts/fireworks/models/playground-v2-5-1024px-aesthetic
#
# 【自部署 ComfyUI / Stable Diffusion WebUI（带 OpenAI 桥）】
# CUSTOM_IMAGE_BASE_URL=http://localhost:8188/v1
# CUSTOM_IMAGE_MODEL=flux-dev

# ── 内置 provider（保留以备切换）──

# MiniMax 文生图
# 注：image-01 在中文 logo 场景质量较弱，推荐切到 custom 走 FLUX/SDXL。
MINIMAX_API_KEY=
MINIMAX_IMAGE_MODEL=image-01

# OpenAI 文生图
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# 阿里 DashScope 通义万相
DASHSCOPE_API_KEY=
TONGYI_IMAGE_MODEL=wanx-v1

# --- 输出目录（相对项目根）---
ARTIFACTS_DIR=artifacts
